{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!public/r",
      "!pnpm-lock.yaml",
      /*
       * Biome's CSS parser cannot read Tailwind v4's at-rule parameters — it
       * treats the `static` in `@theme inline static` as a type selector and
       * bails out, which then aborts formatting for the whole file. Narrow
       * parser, common result: the check reports a syntax error on valid CSS.
       *
       * The package's stylesheets are therefore outside Biome, including the
       * sheets split out of `base.css`: they are one hand-formatted source
       * that happens to ship as several files, and the formatter would
       * otherwise reflow only the halves it can parse. Token declarations and
       * references
       * are checked locally by `scripts/check-tokens.mjs`; the gallery tests
       * verify their computed styles in a real browser.
       */
      "!packages/claralight/styles/*.css",
      "!apps/docs/src/index.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "a11y": {
        /*
         * `Input` is `@base-ui/react/input` and `NumberInput` wraps
         * `@base-ui/react/number-field`; both render a real `<input>`, so
         * wrapping them in a `<label>` associates correctly — Biome just cannot
         * see through the component. Listing them here keeps the rule on for
         * genuinely unassociated labels, which is how the Select trigger was
         * caught: a `<label>` around a `<button>` overrides the button's
         * accessible name with the label text, hiding the selected value.
         */
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "NumberInput", "Textarea", "Checkbox", "Switch", "Radio"]
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["registry.json", "**/registry.json", "public/r/**"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    }
  ]
}
