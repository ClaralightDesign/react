{
  "name": "@claralight-design/react",
  "version": "0.0.3",
  "description": "ClaraLight Design — a quiet, layered design language for React. Base UI primitives, Tailwind v4 tokens, copy-in source.",
  "homepage": "https://claralightdesign.github.io/react/",
  "bugs": {
    "url": "https://github.com/ClaralightDesign/react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClaralightDesign/react.git",
    "directory": "packages/claralight"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/index.css",
    "./theme.css": "./styles/theme.css",
    "./base.css": "./styles/base.css",
    "./anchored.css": "./styles/anchored.css",
    "./tooltip.css": "./styles/tooltip.css",
    "./scroll-area.css": "./styles/scroll-area.css",
    "./progress.css": "./styles/progress.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm build && pnpm typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:exports": "publint --strict"
  },
  "dependencies": {
    "@lisse/core": "catalog:",
    "@lisse/react": "catalog:",
    "@scritto/react": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "class-variance-authority": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "claralight",
    "design-system",
    "react",
    "base-ui",
    "tailwindcss",
    "registry"
  ],
  "publishConfig": {
    "access": "public"
  }
}
