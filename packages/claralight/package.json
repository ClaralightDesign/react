{
  "name": "@claralight/react",
  "version": "0.1.0",
  "description": "ClaraLight Design \u2014 a quiet, layered design language for React. Base UI primitives, Tailwind v4 tokens, copy-in source.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/index.css",
    "./theme.css": "./styles/theme.css",
    "./base.css": "./styles/base.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:exports": "publint --strict"
  },
  "dependencies": {
    "@lisse/react": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "class-variance-authority": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "claralight",
    "design-system",
    "react",
    "base-ui",
    "tailwindcss",
    "registry"
  ],
  "publishConfig": {
    "access": "public"
  }
}
