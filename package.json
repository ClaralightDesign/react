{
  "name": "claralight-design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "pnpm --filter @claralight-design/react build",
    "build:all": "pnpm -r build",
    "check": "pnpm lint && pnpm check:tokens && pnpm test && pnpm typecheck && pnpm check:exports && pnpm check:registry && pnpm check:gallery",
    "check:exports": "pnpm build && pnpm --filter @claralight-design/react check:exports",
    "check:gallery": "pnpm build:all && node scripts/check-gallery.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "clean": "rm -rf packages/*/dist apps/*/dist public/r",
    "dev": "pnpm --filter @claralight-design/react build && pnpm --parallel --filter @claralight-design/react --filter @claralight/docs dev",
    "dev:docs": "pnpm build && pnpm --filter @claralight/docs dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "registry:build": "shadcn build registry.json --output public/r",
    "registry:validate": "shadcn registry validate ./registry.json",
    "test": "node --test scripts/*.test.mjs && pnpm --filter @claralight-design/react test",
    "tokens": "node scripts/gen-spring.mjs --write",
    "typecheck": "pnpm build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "puppeteer-core": "^25.10.0",
    "shadcn": "catalog:",
    "typescript": "catalog:"
  }
}
