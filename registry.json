{
	"$schema": "https://ui.shadcn.com/schema/registry.json",
	"name": "claralight",
	"homepage": "https://github.com/claralight/ClaralightDesign-React",
	"items": [
		{
			"name": "claralight",
			"type": "registry:base",
			"title": "ClaraLight Design",
			"description": "Shared design tokens, CSS primitives and utilities. Configure the @claralight registry namespace before installing any item. Requires the @/lib alias to point to your lib directory, including in your CSS bundler.",
			"author": "ClaraLight",
			"dependencies": [
				"@base-ui/react",
				"class-variance-authority",
				"cn",
				"@lisse/core@^0.7.2",
				"@lisse/react@^0.7.2"
			],
			"css": {
				"@import \"@/lib/claralight/theme.css\"": {},
				"@import \"@/lib/claralight/base.css\"": {}
			},
			"files": [
				{
					"path": "packages/claralight/styles/theme.css",
					"type": "registry:file",
					"target": "@lib/claralight/theme.css"
				},
				{
					"path": "packages/claralight/styles/base.css",
					"type": "registry:file",
					"target": "@lib/claralight/base.css"
				},
				{
					"path": "packages/claralight/src/lib/utils.ts",
					"type": "registry:file",
					"target": "@lib/utils.ts"
				},
				{
					"path": "packages/claralight/src/lib/squircle.tsx",
					"type": "registry:file",
					"target": "@lib/squircle.tsx"
				}
			]
		},
		{
			"name": "button",
			"type": "registry:ui",
			"title": "Button",
			"description": "The ClaraLight capsule control: four variants, three densities, and the signature press spring.",
			"dependencies": ["@base-ui/react", "class-variance-authority"],
			"registryDependencies": ["@claralight/claralight"],
			"files": [
				{
					"path": "packages/claralight/src/ui/button.tsx",
					"type": "registry:ui"
				}
			]
		},
		{
			"name": "input",
			"type": "registry:ui",
			"title": "Input",
			"description": "A text field whose fill is a translucent overlay, so it reads correctly on the window background and inside a panel alike.",
			"dependencies": ["@base-ui/react", "class-variance-authority"],
			"registryDependencies": ["@claralight/claralight"],
			"files": [
				{
					"path": "packages/claralight/src/ui/input.tsx",
					"type": "registry:ui"
				}
			]
		},
		{
			"name": "card",
			"type": "registry:ui",
			"title": "Card",
			"description": "A surface on the ClaraLight layer stack, in the three places a card can sit: on the window, inside a panel, or floating over content.",
			"dependencies": ["class-variance-authority", "@lisse/react@^0.7.2"],
			"registryDependencies": ["@claralight/claralight"],
			"files": [
				{
					"path": "packages/claralight/src/ui/card.tsx",
					"type": "registry:ui"
				}
			]
		},
		{
			"name": "dialog",
			"type": "registry:ui",
			"title": "Dialog",
			"description": "A frosted modal. Base UI owns focus trapping, scroll locking, Escape and nested dialogs; ClaraLight owns the surface and the entrance.",
			"dependencies": ["@base-ui/react"],
			"registryDependencies": ["@claralight/claralight"],
			"files": [
				{
					"path": "packages/claralight/src/lib/morph.tsx",
					"type": "registry:file",
					"target": "@lib/morph.tsx"
				},
				{
					"path": "packages/claralight/src/ui/dialog.tsx",
					"type": "registry:ui"
				}
			]
		},
		{
			"name": "popover",
			"type": "registry:ui",
			"title": "Popover",
			"description": "An overlay that points at what opened it. The arrow is part of the surface's own path, so the frost, the blur and the outline cross the join as one shape.",
			"dependencies": ["@base-ui/react", "@lisse/core@^0.7.2"],
			"registryDependencies": ["@claralight/claralight"],
			"css": {
				"@import \"@/lib/claralight/anchored.css\"": {}
			},
			"files": [
				{
					"path": "packages/claralight/styles/anchored.css",
					"type": "registry:file",
					"target": "@lib/claralight/anchored.css"
				},
				{
					"path": "packages/claralight/src/lib/anchored.tsx",
					"type": "registry:file",
					"target": "@lib/anchored.tsx"
				},
				{
					"path": "packages/claralight/src/ui/popover.tsx",
					"type": "registry:ui"
				}
			]
		},
		{
			"name": "tooltip",
			"type": "registry:ui",
			"title": "Tooltip",
			"description": "The same anchored surface, one step quieter. Hover or focus reveals a label after a dwell that a whole group of controls shares.",
			"dependencies": ["@base-ui/react", "@lisse/core@^0.7.2"],
			"registryDependencies": ["@claralight/claralight"],
			"css": {
				"@import \"@/lib/claralight/anchored.css\"": {},
				"@import \"@/lib/claralight/tooltip.css\"": {}
			},
			"files": [
				{
					"path": "packages/claralight/styles/anchored.css",
					"type": "registry:file",
					"target": "@lib/claralight/anchored.css"
				},
				{
					"path": "packages/claralight/src/lib/anchored.tsx",
					"type": "registry:file",
					"target": "@lib/anchored.tsx"
				},
				{
					"path": "packages/claralight/styles/tooltip.css",
					"type": "registry:file",
					"target": "@lib/claralight/tooltip.css"
				},
				{
					"path": "packages/claralight/src/ui/tooltip.tsx",
					"type": "registry:ui"
				}
			]
		},
		{
			"name": "select",
			"type": "registry:ui",
			"title": "Select",
			"description": "A select whose popup grows from the trigger, because Base UI computes --transform-origin from the trigger's real position.",
			"dependencies": ["@base-ui/react"],
			"registryDependencies": ["@claralight/claralight"],
			"files": [
				{
					"path": "packages/claralight/src/ui/select.tsx",
					"type": "registry:ui"
				}
			]
		}
	]
}
