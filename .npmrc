# pnpm resolves the `catalog:` protocol from pnpm-workspace.yaml.
link-workspace-packages=true

# Keep the store deduplicated across the two workspace packages.
shared-workspace-lockfile=true

# Allow upstream peer-range differences; the library declares its peers explicitly.
strict-peer-dependencies=false

# Faster installs; we never rely on a flat node_modules layout.
node-linker=isolated
